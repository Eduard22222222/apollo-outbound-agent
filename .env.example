# Copy to .env  -  NEVER commit .env
#
# Scoped key: Apollo -> Settings -> Integrations -> API.  Tick ONLY the scopes in docs/07 4.
APOLLO_API_KEY=

# Master key: needed ONLY for the one-off access audit (GET /api/v1/users/search).
# Mint it, run scripts/audit_access.py, then REVOKE it and clear this line.
# privacy_gate.py check G5 fails while this is still set after the audit exists.
APOLLO_MASTER_API_KEY=
